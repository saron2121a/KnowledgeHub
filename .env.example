# Local LLM configuration
LLM_PROVIDER=ollama
MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=3600

# Retrieval configuration
USE_HYBRID=false
USE_RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L2-v2